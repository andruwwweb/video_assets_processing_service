# Шаблон окружения. Скопируй в .env и заполни секреты:  cp .env.example .env

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0

# --- PostgreSQL ---
POSTGRES_USER=mpp
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=mpp
POSTGRES_PORT=5432
DATABASE_URL=postgres://mpp:__CHANGE_ME__@localhost:5432/mpp

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object Storage (MinIO в dev, S3 в prod) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=__CHANGE_ME__
S3_BUCKET=media
S3_FORCE_PATH_STYLE=true

# --- API docs / dev ---
API_DOCS_ENABLED=true
DEV_ACCOUNT_ID=00000000-0000-0000-0000-000000000001

# --- Presigned URL TTL (секунды) ---
PRESIGN_PUT_TTL_SECONDS=900
PRESIGN_GET_TTL_SECONDS=900

# --- Worker: таймауты FFmpeg (мс) ---
PROBE_TIMEOUT_MS=30000
TRANSCODE_TIMEOUT_MS=600000
