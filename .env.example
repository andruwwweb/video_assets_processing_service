# Environment template. Copy to .env and fill in secrets:  cp .env.example .env

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0
# Public API base URL — the OpenAPI `servers` entry the Sandbox sends requests to.
API_PUBLIC_URL=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_USER=mpp
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=mpp
POSTGRES_PORT=5432
DATABASE_URL=postgres://mpp:__CHANGE_ME__@localhost:5432/mpp

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object Storage (MinIO in dev, S3 in prod) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=__CHANGE_ME__
S3_BUCKET=media
S3_FORCE_PATH_STYLE=true

# --- API docs / dev ---
API_DOCS_ENABLED=true
# Browser origin(s) for the dashboard (comma-separated), e.g. the Next dev server.
CORS_ORIGIN=http://localhost:3001
DEV_ACCOUNT_ID=00000000-0000-0000-0000-000000000001

# --- Presigned URL TTL (seconds) ---
PRESIGN_PUT_TTL_SECONDS=900
PRESIGN_GET_TTL_SECONDS=900

# --- Worker: FFmpeg timeouts (ms) ---
PROBE_TIMEOUT_MS=30000
TRANSCODE_TIMEOUT_MS=600000
MEDIA_LIGHT_TIMEOUT_MS=120000

# --- Auth / rate limit / webhooks (stage 5) ---
JWT_SECRET=__CHANGE_ME__
JWT_TTL_SECONDS=86400
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
API_KEY_CACHE_TTL_SECONDS=60
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5
