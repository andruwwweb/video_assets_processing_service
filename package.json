{
  "name": "media-processing-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=!@mpp/worker",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
    "infra:reset": "docker compose --env-file .env -f infra/docker-compose.yml down -v",
    "db:generate": "pnpm --filter @mpp/db generate",
    "db:migrate": "pnpm --filter @mpp/db migrate",
    "db:seed": "pnpm --filter @mpp/db seed",
    "db:studio": "pnpm --filter @mpp/db studio"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.10.1"
    }
  }
}
